{
  "name": "drop-2f75d9cf-ece",
  "compatibility_date": "2026-08-09",
  // worker.js runs in front of every request (password gate) — see that
  // file for the password itself and how the allowlist of ungated static
  // files (style.css, logo, fonts) is chosen.
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, Cloudflare serves any request matching a real file in
    // dist/ directly and worker.js never runs — since every page here is a
    // real static file, that would make the gate a no-op. This forces
    // worker.js to run first for every request instead.
    "run_worker_first": true
  }
}
